INFRARESEARCH_DATA_DIR=./data
INFRARESEARCH_DATABASE_URL=sqlite:///./data/infraresearch.db
INFRARESEARCH_VECTOR_BACKEND=qdrant
INFRARESEARCH_EMBEDDING_BACKEND=fastembed
INFRARESEARCH_EMBEDDING_MODEL=intfloat/multilingual-e5-small
INFRARESEARCH_EMBEDDING_DIMENSIONS=384
INFRARESEARCH_EMBEDDING_CACHE_DIR=~/.cache/fastembed
INFRARESEARCH_EMBEDDING_LOCAL_FILES_ONLY=false
INFRARESEARCH_RERANKER_BACKEND=identity
INFRARESEARCH_RERANKER_MODEL=BAAI/bge-reranker-base
INFRARESEARCH_RERANKER_CACHE_DIR=~/.cache/fastembed
INFRARESEARCH_RERANKER_LOCAL_FILES_ONLY=false
INFRARESEARCH_CANDIDATE_K=20
INFRARESEARCH_EVIDENCE_K=6
INFRARESEARCH_RETRIEVAL_MODE=hybrid
INFRARESEARCH_HYBRID_RRF_K=60
INFRARESEARCH_HYBRID_DENSE_WEIGHT=1.0
INFRARESEARCH_HYBRID_LEXICAL_WEIGHT=1.0
INFRARESEARCH_PDF_LAYOUT_ENABLED=true
INFRARESEARCH_PDF_OCR_ENABLED=true
INFRARESEARCH_PDF_OCR_MIN_CHARS=40
INFRARESEARCH_PDF_OCR_DPI=200
INFRARESEARCH_PDF_OCR_LANGUAGE=eng
INFRARESEARCH_LLM_BASE_URL=http://127.0.0.1:8001/v1
INFRARESEARCH_LLM_API_KEY=local
INFRARESEARCH_LLM_MODEL=Qwen/Qwen3-0.6B
INFRARESEARCH_VLLM_MODEL_PATH=
INFRARESEARCH_VLLM_VENV=./.venv-vllm
INFRARESEARCH_VLLM_GPU_MEMORY_UTILIZATION=0.75
INFRARESEARCH_VLLM_MAX_MODEL_LEN=8192
INFRARESEARCH_VLLM_PREFIX_CACHING=1
INFRARESEARCH_LLM_TIMEOUT_SECONDS=60
INFRARESEARCH_LLM_TEMPERATURE=0.1
INFRARESEARCH_WORKER_POLL_SECONDS=0.25
INFRARESEARCH_WORKER_HEARTBEAT_SECONDS=2
INFRARESEARCH_WORKER_STALE_SECONDS=30
INFRARESEARCH_MAX_UPLOAD_MB=25
INFRARESEARCH_MAX_WEB_MB=5
INFRARESEARCH_MAX_REPO_FILES=2000
INFRARESEARCH_MAX_GITHUB_ISSUES=1000
INFRARESEARCH_MAX_AGENT_REWRITES=2
INFRARESEARCH_TOKEN_BUDGET=6000
INFRARESEARCH_CITATION_REPAIR_ENABLED=true
INFRARESEARCH_CITATION_SUPPORT_THRESHOLD=0.18
INFRARESEARCH_INPUT_COST_PER_MILLION_TOKENS=0
INFRARESEARCH_OUTPUT_COST_PER_MILLION_TOKENS=0
INFRARESEARCH_WEB_SEARCH_ENABLED=false
INFRARESEARCH_WEB_SEARCH_ENDPOINT=https://api.search.brave.com/res/v1/web/search
INFRARESEARCH_WEB_SEARCH_API_KEY=
